# Leave empty to call same-origin `/api` (recommended: Vite proxy / Vercel rewrite).
# Set only if the frontend must talk to the API host directly (CORS + HTTPS required).
VITE_API_URL=

# Vite dev/preview proxy target for `/api` (not exposed to the client).
# Hackathon API (copy to .env.local):
# API_PROXY_TARGET=http://193.233.246.230:8080
API_PROXY_TARGET=http://localhost:8080
